{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "lebenslaeufe-app": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss",
                    "changeDetection": "OnPush",
                    "prefix": "lla",
                    "type": "Component"
                }
            },
            "root": "frontend",
            "sourceRoot": "frontend/src",
            "prefix": "lla",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:application",
                    "options": {
                        "outputPath": "frontend/dist/lebenslaeufe-app",
                        "index": "frontend/src/index.html",
                        "browser": "frontend/src/main.ts",
                        "polyfills": [],
                        "tsConfig": "frontend/tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "frontend/public"
                            }
                        ],
                        "styles": ["frontend/src/styles.scss"],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "extractLicenses": true,
                            "namedChunks": false,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "800kB",
                                    "maximumError": "1MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "4kB",
                                    "maximumError": "8kB"
                                }
                            ],
                            "outputHashing": "all",
                            "fileReplacements": [
                                {
                                    "replace": "frontend/src/environments/environment.ts",
                                    "with": "frontend/src/environments/environment.production.ts"
                                }
                            ],
                            "serviceWorker": "frontend/ngsw-config.json",
                            "define": {
                                "llaDevMode": "false"
                            }
                        },
                        "testing": {
                            "define": {
                                "llaDevMode": "true"
                            }
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "define": {
                                "llaDevMode": "true"
                            }
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "lebenslaeufe-app:build:production"
                        },
                        "development": {
                            "buildTarget": "lebenslaeufe-app:build:development"
                        }
                    },
                    "defaultConfiguration": "development",
                    "options": {
                        "proxyConfig": "frontend/proxy.conf.json"
                    }
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n"
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "polyfills": [],
                        "tsConfig": "frontend/tsconfig.spec.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "frontend/public"
                            }
                        ],
                        "styles": ["frontend/src/styles.scss"],
                        "scripts": []
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": ["frontend/src/**/*.ts", "frontend/src/**/*.html"]
                    }
                }
            }
        }
    },
    "cli": {
        "schematicCollections": ["angular-eslint"]
    },
    "schematics": {
      "@schematics/angular:component": {
        "type": "component"
      },
      "@schematics/angular:directive": {
        "type": "directive"
      },
      "@schematics/angular:service": {
        "type": "service"
      },
      "@schematics/angular:guard": {
        "typeSeparator": "."
      },
      "@schematics/angular:interceptor": {
        "typeSeparator": "."
      },
      "@schematics/angular:module": {
        "typeSeparator": "."
      },
      "@schematics/angular:pipe": {
        "typeSeparator": "."
      },
      "@schematics/angular:resolver": {
        "typeSeparator": "."
      }
    }
}
